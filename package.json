{
  "name": "mem-brane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web 'npm:dev:server' 'npm:dev:web'",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "tsx watch --env-file-if-exists=.env server/app/main.ts",
    "db:migrate": "node --import tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "node --import tsx --env-file-if-exists=.env scripts/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && esbuild server/app/main.ts --bundle --format=esm --platform=node --target=node22 --packages=external --outfile=dist-server/main.js",
    "start": "node --env-file-if-exists=.env dist-server/main.js",
    "format": "prettier --write src server shared scripts tests docs *.md *.json *.ts *.html",
    "format:check": "prettier --check src server shared scripts tests docs *.md *.json *.ts *.html",
    "test:browser": "npm run build && playwright test",
    "verify": "npm run format:check && npm run build && npm test && playwright test"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@hono/node-server": "^1.19.0",
    "@tanstack/react-router": "^1.130.0",
    "@xyflow/react": "^12.9.0",
    "ai": "^6.0.0",
    "better-auth": "^1.4.0",
    "better-sqlite3": "^12.0.0",
    "dotenv": "^17.0.0",
    "hono": "^4.10.0",
    "ipaddr.js": "^2.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.4",
    "undici": "^7.0.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
