PORT=3001
APP_ORIGIN=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
DATABASE_PATH=data/mem-brane.sqlite
ASSET_DIRECTORY=data/assets
MODEL_DEFAULT=mock
MODEL_ALLOWLIST=mock
OPENAI_API_KEY=
WORKER_CONCURRENCY=2
USER_RUN_LIMIT=3
MAX_OUTPUT_TOKENS=1024
MAX_CONTEXT_CHARACTERS=100000
MAX_WEBPAGE_BYTES=1048576
MAX_UPLOAD_BYTES=5242880
DAILY_USER_SPEND_LIMIT=0
CHECKPOINT_INTERVAL_MS=1000
CHECKPOINT_CHARACTERS=256
LEASE_MS=30000
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Production: NODE_ENV=production, APP_ORIGIN=https://your-domain
# Paid admission is disabled while DAILY_USER_SPEND_LIMIT=0.
# Supply operator-verified prices before allowing a non-mock model.
# Per-model shape: {inputUsdPerMillion,outputUsdPerMillion,vision,imageTokenBound,source,verifiedAt}
# imageTokenBound must conservatively cover low-detail input for that model.
MODEL_PRICING_JSON={}
# Run deadlines include asset preparation. Idle resets when output arrives.
RUN_TOTAL_MS=300000
RUN_IDLE_MS=60000
SHUTDOWN_MS=20000
# Paid admission requires both positive actor and operator budgets.
GLOBAL_DAILY_SPEND_LIMIT=0
USER_STORAGE_BYTES=104857600
TOTAL_STORAGE_BYTES=1073741824
USER_IMPORT_LIMIT=3
IMPORT_QUEUE_LIMIT=6
RUN_QUEUE_LIMIT=8

# Operational safety and bounded cleanup
MIN_FREE_DISK_BYTES=1073741824
DISK_CHECK_INTERVAL_MS=15000
TELEMETRY_INTERVAL_MS=10000
COMPLETED_CHECKPOINT_RETENTION_DAYS=7
# Recovery rehearsal: disables new writes and background claims.
READ_ONLY=0
