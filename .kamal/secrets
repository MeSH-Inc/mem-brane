# Read from the macOS Keychain; nothing secret is committed. Store values with
# ~/apps/selfhost/keychain-secret or railway-to-keychain (README.md there).
BETTER_AUTH_SECRET=$(security find-generic-password -s kamal/mem-brane -a BETTER_AUTH_SECRET -w)
SIGNUP_INVITE_CODE=$(security find-generic-password -s kamal/mem-brane -a SIGNUP_INVITE_CODE -w)
DEEPSEEK_API_KEY=$(security find-generic-password -s kamal/mem-brane -a DEEPSEEK_API_KEY -w)
MODEL_PRICING_JSON=$(security find-generic-password -s kamal/mem-brane -a MODEL_PRICING_JSON -w)
BACKUP_ACCESS_KEY_ID=$(security find-generic-password -s kamal/mem-brane -a BACKUP_ACCESS_KEY_ID -w)
BACKUP_SECRET_ACCESS_KEY=$(security find-generic-password -s kamal/mem-brane -a BACKUP_SECRET_ACCESS_KEY -w)
# Litestream uses the same R2 token as the bundle backups.
LITESTREAM_ACCESS_KEY_ID=$(security find-generic-password -s kamal/mem-brane -a BACKUP_ACCESS_KEY_ID -w)
LITESTREAM_SECRET_ACCESS_KEY=$(security find-generic-password -s kamal/mem-brane -a BACKUP_SECRET_ACCESS_KEY -w)
