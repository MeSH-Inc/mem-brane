NODE_ENV=production
PORT=3001
APP_ORIGIN=https://mem-brane.com
HOST=0.0.0.0
REDIRECT_HOSTS=www.mem-brane.com
SIGNUP_MODE=invite
# Generate a separate random invitation code, at least 32 characters.
SIGNUP_INVITE_CODE=
# Generate using: node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64url"))'
BETTER_AUTH_SECRET=
DATABASE_PATH=/var/lib/mem-brane/mem-brane.sqlite
ASSET_DIRECTORY=/var/lib/mem-brane/assets
# Set actual model IDs, verified pricing, and positive budgets to admit paid runs.
MODEL_DEFAULT=mock
MODEL_ALLOWLIST=mock
OPENAI_API_KEY=
MODEL_PRICING_JSON={}
DAILY_USER_SPEND_LIMIT=0
GLOBAL_DAILY_SPEND_LIMIT=0
GLOBAL_MONTHLY_SPEND_LIMIT=0
# Optional R2. Leave all four empty to use persistent local files.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
MAX_UPLOAD_BYTES=5242880
MAX_OUTPUT_TOKENS=1024
USER_STORAGE_BYTES=104857600
TOTAL_STORAGE_BYTES=1073741824
RUN_TOTAL_MS=300000
RUN_IDLE_MS=60000
SHUTDOWN_MS=20000
# Activate only after a deliberately authorized provider smoke test and credit grant.
OCR_PROVIDER=disabled
MISTRAL_API_KEY=
OCR_DAILY_SPEND_LIMIT=10
OCR_MONTHLY_SPEND_LIMIT=100
# No public checkout or automatic refill is implemented.

# Optional scheduled off-volume backups: all five settings are required together.
BACKUP_ENDPOINT=
BACKUP_BUCKET=
BACKUP_REGION=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
